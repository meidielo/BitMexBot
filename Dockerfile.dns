FROM debian:bookworm-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        dnsutils \
        stubby \
    && groupadd --system --gid 10002 resolver \
    && useradd --system --uid 10002 --gid resolver --home-dir /nonexistent \
       --shell /usr/sbin/nologin resolver \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/stubby.yml /etc/stubby/bitmexbot-stubby.yml

EXPOSE 53/tcp 53/udp

HEALTHCHECK --interval=20s --timeout=5s --retries=3 --start-period=10s \
    CMD dig +short +time=3 +tries=1 @127.0.0.1 testnet.bitmex.com A \
        | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || exit 1

USER 10002:10002
ENTRYPOINT ["stubby", "-C", "/etc/stubby/bitmexbot-stubby.yml"]
