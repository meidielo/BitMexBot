# Dedicated BitMEX Testnet API credentials.
# Create at https://testnet.bitmex.com/app/apiKeys
# Required: order read/write. Never enable withdrawal permission.
BITMEX_TESTNET_API_KEY=your_testnet_api_key_here
BITMEX_TESTNET_API_SECRET=your_testnet_api_secret_here

# The authenticated client requires this exact, case-sensitive value.
# Authenticated mainnet client construction is not implemented.
BITMEX_TESTNET=true
